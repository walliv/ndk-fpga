# Local, machine-specific Claude context (not for commit)
CLAUDE.local.md

# Vivado build output. Only the sources and the build recipe belong in the tree; the project
# the build creates is regenerated by `make` and runs to hundreds of MB per card.
apps/*/build/*/*.runs/
apps/*/build/*/*.cache/
apps/*/build/*/*.gen/
apps/*/build/*/*.hw/
apps/*/build/*/*.sim/
apps/*/build/*/*.srcs/
apps/*/build/*/*.xpr
apps/*/build/*/*.bit
apps/*/build/*/*.dcp
apps/*/build/*/*.nfw
apps/*/build/*/*.log
apps/*/build/*/src/ipcfg_*/

# nvc work libraries, created beside each testbench by `make nvc-elab`
work/

# DevTree/XDC scratch written by the component-level build
*.netcope_tmp/
netcope_tmp/

# editor and scratch leftovers
*.bak
*.bak-*
*.orig
*.rej
*~

# Vivado per-run reports written beside the project
apps/*/build/*/*_par.*
apps/*/build/*/*_synth.*
apps/*/build/*/messages-*.txt
