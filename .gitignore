# Local, machine-specific Claude context (not for commit)
CLAUDE.local.md

resources/

# cocotb / nvc build artifacts, generated in-tree next to each testbench
nvcwork/
__pycache__/
results.xml
*.vivado.mk
*.netcope_tmp/
# The component benches write theirs to a bare netcope_tmp/, which the pattern above misses.
netcope_tmp/
DevTree_paths.txt

# nvc code coverage databases/reports (opt-in via COVERAGE_EN, see build/common.mk)
*.ncdb
coverage_report/

# Vivado build output. Only the sources and the build recipe belong in the tree; the project
# the build creates is regenerated by `make` and runs to hundreds of MB per card.
apps/*/build/*/*.runs/
apps/*/build/*/*.cache/
apps/*/build/*/*.gen/
apps/*/build/*/*.hw/
apps/*/build/*/*.sim/
apps/*/build/*/*.srcs/
apps/*/build/*/*.xpr
apps/*/build/*/*.bit
apps/*/build/*/*.dcp
apps/*/build/*/*.nfw
apps/*/build/*/*.log
apps/*/build/*/src/ipcfg_*/

# nvc work libraries, created beside each testbench by `make nvc-elab`
work/

# editor and scratch leftovers
*.bak
*.bak-*
*.orig
*.rej
*~

# Vivado per-run reports written beside the project
apps/*/build/*/*_par.*
apps/*/build/*/*_synth.*
apps/*/build/*/messages-*.txt
