# Generated by gen_devtree.tcl (make devtree) from the application's DevTree.tcl
lappend PACKAGES "$ENTITY_BASE/sim/combo_user_const_pkg.vhd"
lappend PACKAGES "$::env(NETCOPE_TEMP)DevTree.vhd"

# The parameters apps/scratchpad/build/alveo-v80/Vivado.tcl hands to CORE_LOGIC
set CORE_LOGIC_ARCHGRP [list CORE_BASE "$OFM_PATH/core" PCIE_MOD_ARCH "CPM5" PCIE_GEN 5 PCIE_ENDPOINTS 2 PCIE_ENDPOINT_MODE 1]
lappend COMPONENTS [list "CORE_LOGIC" "$ENTITY_BASE/.." $CORE_LOGIC_ARCHGRP]

# Bound by default binding to the components CORE_LOGIC, PCIE_CORE (CPM5) and SCRATCHPAD_NMU declare
lappend MOD "$ENTITY_BASE/sim/cpm5_cips_wrapper_sim.vhd"
lappend MOD "$ENTITY_BASE/sim/v80_hbm_wrapper_sim.vhd"
lappend MOD "$ENTITY_BASE/sim/xpm_nmu_mm_sim.vhd"
